$TTL    604800
@       IN      SOA     ns.jonas.lan. admin.jonas.lan. (
                        2026052001 ; Serial
                        604800     ; Refresh
                        86400      ; Retry
                        2419200    ; Expire
                        604800 )   ; Negative Cache TTL

; Nameservers
        IN      NS      ns.jonas.lan.

; Hosts (Apontando para o localhost onde as portas estão expostas)
ns          IN      A       127.0.0.1
jonastech   IN      A       127.0.0.1
jonasredes  IN      A       127.0.0.1
jonasti     IN      A       127.0.0.1
mail        IN      A       127.0.0.1
@   IN  MX 10 mail.jonas.lan.

; Aliases
www         IN      CNAME   jonastech.jonas.lan.
portal      IN      CNAME   jonasredes.jonas.lan.
webmail     IN      CNAME   mail.jonas.lan.