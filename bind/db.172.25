$TTL    604800
@   IN  SOA ns.jonas.lan. root.jonas.lan. (
                  6        ; Serial
             604800        ; Refresh
              86400        ; Retry
            2419200        ; Expire
             604800 )      ; Negative Cache TTL
;
@       IN  NS      ns.jonas.lan.

2       IN  PTR     site3.jonas.lan.
3       IN  PTR     ns.jonas.lan.
4       IN  PTR     site2.jonas.lan.
5       IN  PTR     site1.jonas.lan.
10      IN  PTR     proxy.jonas.lan.
20      IN  PTR     mail.jonas.lan.
